# Backend API Keys (Copy to `.env` and fill in your credentials; never commit `.env`)

# Web scraping
OXYLABS_API_KEY=your_oxylabs_username:your_oxylabs_password

# Primary Multi-Model Router (Hostinger AI Router)
HOSTINGER_AI_ROUTER_KEY=your_hostinger_ai_router_key
HOSTINGER_AI_ROUTER_BASE_URL=https://router.hostinger.com/v1
HOSTINGER_API_TOKEN=your_hostinger_api_token
AI_ROUTER_MODELS=gemma-4-31b,nemotron-lightning-3.5-30b-a3b,gemini-3.1-flash-lite

# Optional: Self-hosted Verda Cloud GPU vLLM endpoint (routes Gemma & Nemotron to your Verda cluster)
VERDA_GPU_BASE_URL=
VERDA_API_KEY=
VERDA_GEMMA_MODEL=gemma-checkem-vl
VERDA_NEMOTRON_MODEL=nemotron-checkem-vl
