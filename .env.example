# Backend API Keys (Copy to `.env` and fill in your credentials; never commit `.env`)

# Web scraping
OXYLABS_API_KEY=your_oxylabs_username:your_oxylabs_password

# Primary Multi-Model Router (Hostinger AI Router)
HOSTINGER_AI_ROUTER_KEY=your_hostinger_ai_router_key
HOSTINGER_AI_ROUTER_BASE_URL=https://router.hostinger.com/v1
HOSTINGER_API_TOKEN=your_hostinger_api_token
AI_ROUTER_MODELS=gemma-4-31b,nemotron-3.5-super-vl,gemini-3.1-flash-lite,kimi-k2.6,claude-haiku-4.5

# Managed Nemotron 3.5 Super VL Inference API (falls back to NVIDIA Build / Hostinger Router if unset)
VERDA_INFERENCE_KEY=your_verda_inference_key
NEMOTRON_INFERENCE_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
NEMOTRON_INFERENCE_MODEL=nemotron-3.5-super-vl

# Optional fallback: NVIDIA Build API
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
